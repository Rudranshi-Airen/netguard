# Induced from the UCI Internet Firewall Data log (log2.csv): 65532 real records.
# One rule per destination port seen >= 20 times; action = the port's majority logged action;
# default = overall majority action. Logged actions: ALLOW=37640, DENY=14987, DROP=12851, RESET=54.
ruleset uci_firewall;
field src_port : 0 .. 65535;
field dst_port : 0 .. 65535;
default ALLOW;
rule p0 : DENY when dst_port == 0;   # 173 records
rule p1 : DENY when dst_port == 1;   # 85 records
