# ai_demo_rejection.fw -- same rules as firewall_anomalies.fw, used to demonstrate an AI REJECTION.
# Its AI cache (examples/ai_cache/ai_demo_rejection.fw.json) is HAND-WRITTEN: attempt 1 is a wrong merge
# that NetGuard rejects with a counterexample packet; attempt 2 is the corrected merge. Real Gemini
# replies for this policy are in firewall_anomalies.fw.json.
DENY  TCP FROM ANY TO ANY PORT 22                           # R1
ALLOW TCP FROM 10.0.0.0/8 TO ANY PORT 22                    # R2
ALLOW TCP FROM ANY TO ANY PORT 443                          # R3
ALLOW UDP FROM ANY TO ANY PORT 53                           # R4
ALLOW TCP FROM 192.168.0.0/16 TO ANY PORT 80-89             # R5
ALLOW TCP FROM 192.168.0.0/16 TO ANY PORT 90-100            # R6
ALLOW TCP FROM 192.168.1.0/24 TO ANY PORT 85-95             # R7
DENY  ICMP FROM ANY TO ANY                                  # R8
ALLOW TCP FROM ANY TO 172.16.0.5 PORT 8080                  # R9
ALLOW TCP FROM ANY TO 172.16.0.0/24 PORT 8000-8100          # R10
DEFAULT DENY
